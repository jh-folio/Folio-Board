{
  "name": "folio-os-web",
  "private": true,
  "version": "0.5.4",
  "type": "module",
  "description": "Folio OS React island shell (gradual adoption). Builds fixed-name bundles into ../public/react for the FastAPI static server to serve.",
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build",
    "test": "npm run test:source && npm run test:unit",
    "test:source": "node --test tests/*.test.mjs",
    "test:unit": "vitest run",
    "test:ui": "playwright test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "pixi.js": "^8.20.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "react-doctor": "^0.9.12",
    "react-grab": "0.2.0",
    "react-scan": "0.5.7",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
