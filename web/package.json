{
  "name": "folio-board-web",
  "private": true,
  "version": "0.6.0",
  "type": "module",
  "description": "Folio Board React island shell (gradual adoption). Builds fixed-name bundles into ../public/react for the FastAPI static server to serve.",
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build",
    "test": "npm run test:source && npm run test:unit",
    "test:source": "node --test tests/*.test.mjs",
    "test:unit": "vitest run",
    "test:ui": "playwright test",
    "typecheck": "tsc --noEmit",
    "build:vendor": "node scripts/build-vendor.mjs"
  },
  "dependencies": {
    "pixi.js": "^8.21.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "echarts": "6.1.0",
    "lightweight-charts": "5.2.1",
    "react-doctor": "^0.9.14",
    "react-grab": "0.2.0",
    "react-scan": "0.5.7",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
